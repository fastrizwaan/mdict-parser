<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <dtrn>Puma, panther, catamount, North American tiger <c c="gray">(<co><i>Felis concolor</i> or <i>Puma concolor</i></co>)</c>.</dtrn></ar>
