 <c c="blue">2. </c> <dtrn>Stake, pale.</dtrn>
 <c c="blue">3. </c> <c><co><c c="gray">(<i><c c="green"><abr>Mil.</abr></c></i>)</c></co></c> <dtrn>Sentinel <c c="gray">(<co><i>on the outposts</i></co>)</c>, guard, watchman, guardsman, sentry.</dtrn></ar>
