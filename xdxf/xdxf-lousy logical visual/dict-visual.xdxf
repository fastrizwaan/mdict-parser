<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <c><co><c c="gray">[</c><c c="green"><abr>Fr.</abr></c><c c="gray">]</c></co></c> <dtrn>Rustic <i>or</i> provincial dialect.</dtrn></ar>
