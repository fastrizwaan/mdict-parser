<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <c c="blue">1. </c> <dtrn>Horse-shoe, horse-foot, horse-shoe-crab, limulus <c c="gray">(<co><i>Limulus polyphemus</i></co>)</c>.</dtrn>
 <c c="blue">2. </c> <dtrn>Thornback-crab <c c="gray">(<co><i>Maia squinado</i></co>)</c>.</dtrn></ar>
