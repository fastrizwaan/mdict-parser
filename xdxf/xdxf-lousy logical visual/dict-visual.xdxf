 <c c="blue">1. </c> <dtrn>Exchange.</dtrn>
 <c c="blue">2. </c> <c><co><c c="gray">(<c c="green"><i>Law</i></c>.)</c></co></c> <dtrn>Replacement <c c="gray">(<co><i>of a greater punishment by a less</i></co>)</c>.</dtrn></ar>
<ar><k>commute</k>
