<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <c><co><c c="gray">(<i><c c="green"><abr>Bot.</abr></c></i>)</c></co></c> <dtrn>Licorice <c c="gray">(<co><c c="green"><i>Glycyrrhiza</i></c></co>)</c>.</dtrn></ar>
<ar><k>sweet-rush</k>
<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <dtrn><co><c c="green"><i><c>See</c></i></c></co> <kref>sweet-flag</kref>.</dtrn></ar>
