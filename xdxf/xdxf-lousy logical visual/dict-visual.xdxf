<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <c c="blue">1. </c> <dtrn>Direction, prescript.</dtrn>
 <c c="blue">2. </c> <dtrn>Custom, usage.</dtrn>
 <c c="blue">3. </c> <c><co><c c="gray">(<i><c c="green"><abr>Med.</abr></c></i>)</c></co></c> <dtrn>Recipe.</dtrn></ar>
<ar><k>presence</k>
