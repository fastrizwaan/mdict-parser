 <c c="blue">2. </c> <co><c>[<i>U. S.</i><c c="gray">]</c></c></co> <dtrn>Sycamore, button-tree, button-woods, button-ball-tree, water-beech <c c="gray">(<co><i>Platanus occidentalis</i></co>)</c>.</dtrn>
 <c c="blue">3. </c> <c><co>[<i>Scotland</i>.<c c="gray">]</c></co></c> <dtrn>Sycamore maple <c c="gray">(<co><i>Acer pseudoplatanus</i></co>)</c>.</dtrn></ar>
