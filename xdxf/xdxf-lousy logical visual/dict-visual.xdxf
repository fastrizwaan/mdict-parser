<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <c><co><c c="gray">(<i><c c="green"><abr>Chem.</abr></c></i>)</c></co></c> <dtrn>Humic acid.</dtrn></ar>
