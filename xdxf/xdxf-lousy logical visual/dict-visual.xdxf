<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <dtrn>Wintergreen, tea-berry, partridge-berry, mountain-tea <c c="gray">(<co><i>Gaultheria procumbens</i></co>)</c>.</dtrn></ar>
