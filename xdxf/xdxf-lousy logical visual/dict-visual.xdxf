<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <dtrn>Algebraist.</dtrn></ar>
<ar><k>analytic</k>
<i><c><co><c c="darkorange"><abr>a.</abr></c></co></c></i>; <c c="gray">(<i>also</i> <b>analytical</b>)</c>
 <c c="blue">1. </c> <dtrn>Separative, solvent, resolvent.</dtrn>
 <c c="blue">2. </c> <dtrn>Algebraic.</dtrn></ar>
