<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <c><co><c c="gray">[</c><c c="green"><abr>L.</abr></c><c c="gray">]</c></co></c> <dtrn><co><c c="green"><i><c>See</c></i></c></co> <kref>caseine</kref>.</dtrn></ar>
<ar><k>case-worm</k>
<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <dtrn>Caddice, caddis, cade-worm, cadew, cad-bait, cad-bate, cod-bait.</dtrn></ar>
