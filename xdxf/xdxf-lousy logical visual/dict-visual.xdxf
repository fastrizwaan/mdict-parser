 <c c="blue">1. </c> <dtrn>Simpleton, fool. <i><co><c>See</c></co></i> <kref>dunce</kref>.</dtrn>
 <c c="blue">2. </c> <c><co><c c="gray">(<i><c c="green"><abr>Ornith.</abr></c></i>)</c></co></c> <dtrn>Gannet, noddy, solan, goose <c c="gray">(<co><i>Sula bassana</i> or <i>fusca</i></co>)</c>.</dtrn></ar>
<ar><k>book</k>
