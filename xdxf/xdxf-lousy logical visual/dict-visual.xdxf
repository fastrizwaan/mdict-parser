 <c><co><c c="gray">[</c><c c="green"><abr>L.</abr></c><c c="gray">]</c></co></c> <dtrn>Clot <c c="gray">(<co><i>of blood</i></co>)</c>, coagulation.</dtrn></ar>
<ar><k>cratch-cradle</k>
<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <dtrn>Cat's cradle, scratch-cradle, cradle.</dtrn></ar>
<ar><k>crate</k>
<i><c><co><c c="darkorange"><abr>n.</abr></c></co></c></i>
 <dtrn>Hamper.</dtrn></ar>
